<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.jian.scrcpy</groupId>
    <artifactId>scrcpy-java</artifactId>
    <version>0.2.0-SNAPSHOT</version>
  </parent>
  <artifactId>scrcpy-swing-poc</artifactId>
  <name>scrcpy-java Swing desktop client</name>
  <description>Independent Swing frontend; the JavaFX scrcpy-app module remains unchanged.</description>

  <dependencies>
    <dependency>
      <groupId>com.jian.scrcpy</groupId>
      <artifactId>scrcpy-core</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>com.jian.scrcpy.swing.SwingScrcpyApp</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>