<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.jian.scrcpy</groupId>
    <artifactId>scrcpy-java</artifactId>
    <version>0.2.0-SNAPSHOT</version>
  </parent>
  <artifactId>scrcpy-app</artifactId>
  <dependencies>
    <dependency>
      <groupId>com.jian.scrcpy</groupId>
      <artifactId>scrcpy-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.jian.scrcpy</groupId>
      <artifactId>scrcpy-sdl</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <options>
            <option>--enable-native-access=javafx.graphics</option>
            <option>--add-exports=javafx.graphics/com.sun.prism=ALL-UNNAMED</option>
          </options>
          <mainClass>com.jian.scrcpy.app.ScrcpyApp</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
